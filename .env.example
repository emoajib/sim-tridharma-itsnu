APP_NAME="SIM Tridharma ITSNU"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ===== LOGGING =====
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=

# ===== DATABASE =====
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=sim_tridharma_itsnu
DB_USERNAME=salsabil
DB_PASSWORD=

# ===== SESSION =====
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/

# ===== QUEUE & CACHE =====
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== MAIL =====
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@sim-tridharma.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===== AWS (optional) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ====================================================================
# 🔴 KRITIS: Rotasi SEMUA key di bawah ini segera setelah clone!
# 🔴 Gunakan perintah: openssl rand -base64 32
# 🔴 JANGAN commit .env ke git — file ini sudah di .gitignore
# 🔴 Password database postgres jangan dikosongkan di production
# 🔴 GEMINI_API_KEY adalah kunci billing Google — jaga kerahasiaan
# ====================================================================

# --- AI Agent Microservice ---
AGENT_API_KEY=change-me-to-a-random-secret-immediately
AGENT_API_PORT=8001
AI_INTERNAL_KEY=change-me-in-production-immediately
DATABASE_URL=postgresql://salsabil@localhost:5433/sim_tridharma_itsnu
DB_NAME=sim_tridharma_itsnu

# --- External API Keys (ganti dengan key production) ---
SINTA_API_KEY=
SINTA_API_URL=https://sinta.kemdiktisaintek.go.id/api
SINTA_IMPORT_URL=https://sinta.kemdiktisaintek.go.id/api/v1/authors
PDDIKTI_API_KEY=
PDDIKTI_API_URL=https://api-pddikti.rone.dev
GEMINI_API_KEY=

# --- RAG Service ---
RAG_SERVICE_URL=http://localhost:5001
RAG_SERVICE_PORT=5001

# --- Reverb WebSocket ---
REVERB_APP_ID=akreditasi-reverb
REVERB_APP_KEY=akreditasi-reverb-key
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Sanctum ---
SANCTUM_TOKEN_PREFIX=
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# --- Sentry Error Tracking (opsional) ---
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.25

# ===== MISSING FROM .env (sync) =====

# --- MCP / AI Microservice URLs ---
MCP_AGENTS_URL=http://localhost:8001
MCP_RAG_URL=http://localhost:5001
AI_SERVICE_URL=http://localhost:5001

# --- MCP API Key (used instead of AGENT_API_KEY) ---
MCP_API_KEY=CHANGE_ME

# --- AI Service Auth ---
AI_SERVICE_TOKEN=CHANGE_ME
AGENT_AI_URL=http://localhost:8001

# --- AI Driver Config ---
BRAIN_AI_DRIVER=gemini
BRAIN_GEMINI_MODEL=gemini-1.5-flash

# --- Logging ---
LOG_DEPRECATIONS_CHANNEL=null

# --- Optional ---
MEMCACHED_HOST=127.0.0.1
SESSION_DOMAIN=null
