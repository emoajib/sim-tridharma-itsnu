# MCP AI Agents Configuration
# Copy this file to .env and update values

# Server Configuration
AGENT_API_PORT=8001
AGENT_API_KEY=your-secret-key-change-in-production

# MCP Configuration
MCP_SERVER_NAME=akreditasi-agents
MCP_SERVER_VERSION=1.0.0
MCP_TRANSPORT=streamable-http
MCP_STATELESS=true

# OAuth 2.1 Configuration (optional - for production)
OAUTH_ENABLED=false
OAUTH_JWT_ISSUER=
OAUTH_JWT_AUDIENCE=akreditasi-mcp
OAUTH_REQUIRED_SCOPES=read,write

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=akreditasi
DB_USER=postgres
DB_PASSWORD=your_password

# Redis Configuration (for MCP Tasks backend)
REDIS_URL=redis://localhost:6379/0

# External API Configuration
SINTA_API_URL=https://sinta.kemdiktisaintek.go.id/api
SINTA_API_KEY=
PDDIKTI_API_URL=https://api-pddikti.rone.dev
PDDIKTI_API_KEY=

# Laravel URL (for logging back)
LARAVEL_URL=http://localhost:8000
